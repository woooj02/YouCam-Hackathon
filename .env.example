# Server-side only. Never expose these to the browser.
YOUCAM_API_KEY=          # Perfect Corp YouCam API key (yce.perfectcorp.com/api-console)
YOUCAM_API_SECRET_KEY=   # Matching secret; used to authenticate account-balance requests
# Optional assisted drafting/tagging. Leave both blank for the no-model workflow.
# Provider billing and availability are separate from the YouCam allowance.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force demo mode (no API calls, no units spent) even when keys are set
ENCORE_DEMO=
